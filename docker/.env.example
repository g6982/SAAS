# Copy to .env (setup.sh does it for you and fills in random passwords).

# Base domain of the SaaS. The master answers on it, every client instance gets
# <subdomain>.<SAAS_DOMAIN>, so a wildcard DNS record must point to this host.
# *.localhost resolves to 127.0.0.1 in browsers, which is enough for a local try.
SAAS_DOMAIN=saas.localhost
SAAS_HTTP_PORT=80

# Host directory holding everything the kit writes (client configs, filestores,
# nginx vhosts). Mounted at the same path inside the master container.
SAAS_ROOT=/opt/odoo17

# Master Odoo
MASTER_DB=saas_master
MASTER_HTTP_PORT=8069
MASTER_GEVENT_PORT=8072
MASTER_ADMIN_PASSWD=
MASTER_WORKERS=2

# PostgreSQL, shared by the master and all client instances.
# DB_HOST is the docker0 bridge address (ip -4 addr show docker0).
DB_HOST=172.17.0.1
DB_PORT=5432
DB_USER=odoo
DB_PASSWORD=

# Credentials the kit puts in the template/client containers (saas.conf)
SAAS_TEMPLATE_MASTER=
SAAS_CONTAINER_MASTER=
SAAS_CONTAINER_USER=odooadmin
SAAS_CONTAINER_PASSWD=

# Group id owning /var/run/docker.sock (filled in by setup.sh)
DOCKER_GID=
